<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: the same orbit-and-bead mark as the launcher.

  A notification icon is drawn as a silhouette — Android throws away colour and
  keeps only alpha — so the mark is stated in one flat white and relies on the
  gap between orbit and bead to stay readable at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Scaled up about the centre: there is no adaptive-icon mask to survive
      here, so the artwork can use the full canvas rather than the 72dp safe
      zone the launcher layers are held back to.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.28"
        android:scaleY="1.28">

        <path
            android:pathData="M80.96,52.59 A27,27 0 1 1 55.41,27.04"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="12"
            android:strokeLineCap="round" />

        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M73.09,25.91 a9,9 0 1,0 0,18 a9,9 0 1,0 0,-18 Z" />
    </group>
</vector>
