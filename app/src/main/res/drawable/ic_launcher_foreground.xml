<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a bell with a check mark cut out of it.
  The check is negative space, not a second colour — so the mark keeps its
  meaning when the launcher flattens it to a silhouette for a themed icon.

  Everything is authored at natural size and then scaled 0.88 about the canvas
  centre, which lands the artwork inside the 72dp safe zone (18..90) that every
  launcher mask is guaranteed to leave visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">

        <!--
          Body + check in ONE path with evenOdd fill: where the two subpaths
          overlap, evenOdd punches the hole. Drawing the check as a separate
          light-coloured path instead would disappear in monochrome.
        -->
        <path android:fillType="evenOdd"
            android:pathData="M54,25 C40.7,25 31,35.4 31,49.5 V56 C31,62.5 28.2,66.6 24.5,70 H83.5 C79.8,66.6 77,62.5 77,56 V49.5 C77,35.4 67.3,25 54,25 Z M44.121,48.879 L48.5,53.257 L63.879,37.879 L68.121,42.121 L48.5,61.743 L39.879,53.121 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="22"
                    android:endX="54"
                    android:endY="80">
                    <item android:color="#FFFFFFFF" android:offset="0.0" />
                    <item android:color="#FFE4EFFA" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!--
          Crown, rim and clapper. A separate path element so its overlap with
          the body is a plain union — fillType is per-path, and folding these
          into the evenOdd path above would punch holes where they meet.
        -->
        <path
            android:pathData="M48,22 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z M25.5,68.5 H82.5 A4.5,4.5 0 0,1 82.5,77.5 H25.5 A4.5,4.5 0 0,1 25.5,68.5 Z M44.6,80.5 H63.4 C63.4,85.7 59.2,89.5 54,89.5 C48.8,89.5 44.6,85.7 44.6,80.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="16"
                    android:endX="54"
                    android:endY="90">
                    <item android:color="#FFFFFFFF" android:offset="0.0" />
                    <item android:color="#FFDDEAF8" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
