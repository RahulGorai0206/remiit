<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Full-bleed 108dp so every launcher mask (circle,
  squircle, rounded square) has paint under it.

  The blue is the app's own primary (#31628D in RemiitLightScheme), so a
  dynamic-colour device still shows a launcher icon that matches the brand
  rather than the wallpaper.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="0"
                android:endX="102"
                android:endY="108">
                <item android:color="#FF1B4569" android:offset="0.0" />
                <item android:color="#FF31628D" android:offset="0.55" />
                <item android:color="#FF4E8CC0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      Soft highlight up and left of centre. Keeps the icon from reading as a
      flat swatch at small sizes, where the linear gradient alone is too
      subtle to register.
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="33"
                android:centerY="28"
                android:gradientRadius="82">
                <item android:color="#38FFFFFF" android:offset="0.0" />
                <item android:color="#10FFFFFF" android:offset="0.55" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
