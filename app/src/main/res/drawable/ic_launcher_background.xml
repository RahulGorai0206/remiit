<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Full-bleed 108dp so every launcher mask (circle,
  squircle, rounded square) has paint under it.

  Near-black rather than the app's blue, which is the opposite of what a
  brand-coloured icon usually does — and the point. The mark is a signal, and a
  signal only reads as one against a dark ground. The app's primary makes its
  appearance as the spill behind the orbit rather than as a field of colour,
  which is also closer to what the app is: a quiet thing that lights up at the
  moment something fires, usually at night.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="0"
                android:endX="104"
                android:endY="108">
                <item android:color="#FF141C24" android:offset="0.0" />
                <item android:color="#FF0F1417" android:offset="0.5" />
                <item android:color="#FF0B0F12" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      The light the mark throws, painted on the background layer so it can
      bleed past the glyph without the foreground's own edges clipping it.
      Centred up and right, where the bead sits.
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="62"
                android:centerY="46"
                android:gradientRadius="50">
                <item android:color="#339CCBFB" android:offset="0.0" />
                <item android:color="#1A9CCBFB" android:offset="0.55" />
                <item android:color="#009CCBFB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
