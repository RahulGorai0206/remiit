<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash mark. Same orbit-and-bead geometry as the launcher icon, so the icon
  the user tapped is still on screen while the app starts.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      A single mid-blue rather than the launcher gradient: this sits on
      @color/splash_background, which is near-white in light mode and near-black
      in dark, and this tone is the one that holds contrast against both.
    -->
    <path
        android:pathData="M80.96,52.59 A27,27 0 1 1 55.41,27.04"
        android:strokeColor="#FF4E8CC0"
        android:strokeWidth="12"
        android:strokeLineCap="round" />

    <path
        android:fillColor="#FF4E8CC0"
        android:pathData="M73.09,25.91 a9,9 0 1,0 0,18 a9,9 0 1,0 0,-18 Z" />
</vector>
