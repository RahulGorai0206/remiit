<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app's colours come from the device accent at runtime (Material You
      dynamic colour) or from the Compose fallback scheme in ui/theme. These two
      are only for the pre-Compose window: the splash background and the window
      background painted before the first frame. Keeping them here rather than
      in Compose avoids a white flash on a dark-mode cold start.
    -->
    <color name="window_background">#FFF7F9FF</color>
    <color name="splash_background">#FFF7F9FF</color>
</resources>
